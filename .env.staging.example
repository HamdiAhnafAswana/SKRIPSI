# ============================================================================
# SINOVA — CONTOH konfigurasi lingkungan STAGING (TEMPLATE, TANPA RAHASIA)
#
# Cara pakai:
#   1. Salin berkas ini menjadi `.env.staging` (nama itu TER-IGNORE oleh Git).
#   2. Isi nilai sebenarnya secara manual di .env.staging (JANGAN dikomit).
#   3. Jangan pernah menaruh service-role key / secret apa pun di sini —
#      variabel VITE_* TEREKSPOS ke browser.
#
# Berkas template ini aman dikomit (tidak memuat nilai rahasia).
# ============================================================================

# --- Frontend (Vite) — nilai ini ter-embed ke bundel (bersifat publik) -------
# URL proyek Supabase STAGING. HARUS berbeda dari produksi
# (produksi = rezraqimsvtwhhmxygad). Isi <ref-staging> dari Dashboard.
VITE_SUPABASE_URL=https://<ref-staging>.supabase.co

# Anon/publishable key proyek STAGING (BUKAN service-role key).
VITE_SUPABASE_ANON_KEY=<anon-key-staging>

# Aktifkan dashboard LIVE HANYA di staging.
# Biarkan TIDAK ADA pada lingkungan lokal/produksi agar default tetap DEMO.
VITE_SINOVA_ADMIN_API=live

# Catatan: secret SERVER (Edge Function) TIDAK ditulis di berkas ini.
# Setel lewat mekanisme secret Supabase, mis. pada staging:
#   supabase secrets set --project-ref <ref-staging> \
#     PRACTICE_SESSION_TOKEN_SECRET=<nilai-rahasia> \
#     SINOVA_ALLOWED_ORIGINS="https://staging.contoh.sch.id,http://localhost:5173"
# JANGAN set TOKEN_REQUIRED=false (biarkan fail-closed / diset true).
